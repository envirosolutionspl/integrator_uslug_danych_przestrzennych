<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ChooseLayersDialogBase</class>
 <widget class="QDialog" name="ChooseLayersDialogBase">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>520</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Integrator usług danych przestrzennych</string>
  </property>
  <property name="windowIcon">
   <iconset>
    <normaloff>../images/icon.svg</normaloff>../images/icon.svg</iconset>
  </property>
  <property name="styleSheet">
   <string notr="true">* { font-family: "DejaVu Sans"; }
QFrame#card_layers_search, QFrame#card_layers { border-radius: 6px; background-repeat: repeat-x; background-position: top left; background-origin: border; }
QLabel[role="card-title"] { font-size: 11px; font-weight: bold; padding: 0px 8px; background: transparent; }
QLabel[role="hint"] { font-size: 11px; }
QLabel[role="count"] { font-size: 10px; font-weight: bold; }

QLineEdit { border-radius: 4px; padding: 0px 6px; font-size: 12px; }
QLineEdit#search_lineedit { padding-left: 28px; background-repeat: no-repeat; background-position: left center; background-origin: border; }

QCheckBox { font-size: 11px; spacing: 6px; }
QCheckBox::indicator { width: 14px; height: 14px; border-radius: 3px; }

QTableView { border: none; padding: 0px; font-size: 12px; }
QTableView::item { padding: 0px 6px; border: none; }
QHeaderView::section { font-size: 12px; font-weight: bold; padding: 4px 6px; margin: 0px; border: none; }

QPushButton { border-radius: 4px; padding: 4px 12px; font-size: 11px; }
QPushButton[role="primary"] { font-size: 12px; font-weight: bold; padding: 4px 14px; border: none; }

QPushButton:focus, QCheckBox:focus, QTableView:focus { outline: none; }

QDialog[theme="light"] { background: #ffffff; }
QDialog[theme="light"] QLabel { color: #23282a; }
QDialog[theme="light"] QFrame#card_layers_search { background-color: #ffffff; background-image: url(iudpimg:bar_service_light.svg); border: 1px solid #b9c7ba; }
QDialog[theme="light"] QFrame#card_layers { background-color: #ffffff; background-image: url(iudpimg:bar_list_light.svg); border: 1px solid #d6ded6; }
QDialog[theme="light"] QLabel[role="card-title"] { color: #23282a; }
QDialog[theme="light"] QLabel[role="hint"] { color: #6b7572; }
QDialog[theme="light"] QLabel#lbl_layers_title { color: #3b5a3e; }
QDialog[theme="light"] QLabel[role="count"] { color: #3b5a3e; }

QDialog[theme="light"] QLineEdit { background: #ffffff; color: #23282a; border: 1px solid #b9c7ba; selection-background-color: #4c6e4f; selection-color: #ffffff; }
QDialog[theme="light"] QLineEdit:focus { border: 1px solid #4c6e4f; }
QDialog[theme="light"] QLineEdit#search_lineedit { background-image: url(iudpimg:search.svg); }

QDialog[theme="light"] QCheckBox { color: #23282a; }
QDialog[theme="light"] QCheckBox::indicator { background: #ffffff; border: 1px solid #b9c7ba; }
QDialog[theme="light"] QCheckBox::indicator:hover { border-color: #4c6e4f; }
QDialog[theme="light"] QCheckBox::indicator:checked { background: #4c6e4f; border-color: #4c6e4f; image: url(iudpimg:check.svg); }

QDialog[theme="light"] QTableView { background: #ffffff; alternate-background-color: #f6f8f6; color: #23282a; selection-background-color: #4c6e4f; selection-color: #ffffff; }
QDialog[theme="light"] QTableView::item:selected { background: #4c6e4f; color: #ffffff; }
QDialog[theme="light"] QHeaderView { background: #e8efe8; }
QDialog[theme="light"] QHeaderView::section { background: #e8efe8; color: #3b5a3e; border-top: 1px solid #e8efe8; border-left: none; border-bottom: 1px solid #d6ded6; }

QDialog[theme="light"] QPushButton { background: #ffffff; color: #23282a; border: 1px solid #b9c7ba; }
QDialog[theme="light"] QPushButton:hover { border-color: #4c6e4f; color: #3b5a3e; }
QDialog[theme="light"] QPushButton:pressed { background: #eef3ee; }
QDialog[theme="light"] QPushButton:disabled { color: #9aa39e; border-color: #d6ded6; }
QDialog[theme="light"] QPushButton#reject_btn { qproperty-icon: url(iudpimg:clear.svg); }
QDialog[theme="light"] QPushButton[role="primary"] { background: #4c6e4f; color: #ffffff; border: none; }
QDialog[theme="light"] QPushButton[role="primary"]:hover { background: #5b8260; color: #ffffff; }
QDialog[theme="light"] QPushButton[role="primary"]:pressed { background: #3d5a40; }
QDialog[theme="light"] QPushButton[role="primary"]:disabled { background: #c9d3ca; color: #f4f6f4; }

QDialog[theme="dark"] { background: #2b2d2e; }
QDialog[theme="dark"] QLabel { color: #e6e9e7; }
QDialog[theme="dark"] QFrame#card_layers_search { background-color: #262829; background-image: url(iudpimg:bar_service_dark.svg); border: 1px solid #6f9c73; }
QDialog[theme="dark"] QFrame#card_layers { background-color: #262829; background-image: url(iudpimg:bar_list_dark.svg); border: 1px solid #44494a; }
QDialog[theme="dark"] QLabel[role="card-title"] { color: #ffffff; }
QDialog[theme="dark"] QLabel[role="hint"] { color: #9aa4a0; }
QDialog[theme="dark"] QLabel#lbl_layers_title { color: #a9cfac; }
QDialog[theme="dark"] QLabel[role="count"] { color: #a9cfac; }

QDialog[theme="dark"] QLineEdit { background: #1f2122; color: #e6e9e7; border: 1px solid #5a6162; selection-background-color: #6f9c73; selection-color: #ffffff; }
QDialog[theme="dark"] QLineEdit:focus { border: 1px solid #6f9c73; }
QDialog[theme="dark"] QLineEdit#search_lineedit { background-image: url(iudpimg:search_dark.svg); }

QDialog[theme="dark"] QCheckBox { color: #e6e9e7; }
QDialog[theme="dark"] QCheckBox::indicator { background: #1f2122; border: 1px solid #7a8380; }
QDialog[theme="dark"] QCheckBox::indicator:hover { border-color: #6f9c73; }
QDialog[theme="dark"] QCheckBox::indicator:checked { background: #6f9c73; border-color: #6f9c73; image: url(iudpimg:check.svg); }

QDialog[theme="dark"] QTableView { background: #262829; alternate-background-color: #2b2d2e; color: #e6e9e7; selection-background-color: #6f9c73; selection-color: #ffffff; }
QDialog[theme="dark"] QTableView::item:selected { background: #6f9c73; color: #ffffff; }
QDialog[theme="dark"] QHeaderView { background: #2c3a2d; }
QDialog[theme="dark"] QHeaderView::section { background: #2c3a2d; color: #a9cfac; border-top: 1px solid #2c3a2d; border-left: none; border-bottom: 1px solid #44494a; }

QDialog[theme="dark"] QPushButton { background: #2b2d2e; color: #e6e9e7; border: 1px solid #5a6162; }
QDialog[theme="dark"] QPushButton:hover { border-color: #6f9c73; color: #a9cfac; }
QDialog[theme="dark"] QPushButton:pressed { background: #2c3a2d; }
QDialog[theme="dark"] QPushButton:disabled { color: #6f7773; border-color: #44494a; }
QDialog[theme="dark"] QPushButton#reject_btn { qproperty-icon: url(iudpimg:clear_dark.svg); }
QDialog[theme="dark"] QPushButton[role="primary"] { background: #6f9c73; color: #ffffff; border: none; }
QDialog[theme="dark"] QPushButton[role="primary"]:hover { background: #7fae83; color: #ffffff; }
QDialog[theme="dark"] QPushButton[role="primary"]:pressed { background: #5b8260; }
QDialog[theme="dark"] QPushButton[role="primary"]:disabled { background: #3e4442; color: #8a918e; }
</string>
